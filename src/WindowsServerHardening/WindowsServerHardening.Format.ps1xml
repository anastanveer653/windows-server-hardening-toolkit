<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>WindowsServerHardening.Run</Name>
      <ViewSelectedBy>
        <TypeName>WindowsServerHardening.Run</TypeName>
        <TypeName>Deserialized.WindowsServerHardening.Run</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Mode</Label></TableColumnHeader>
          <TableColumnHeader><Label>Profile</Label></TableColumnHeader>
          <TableColumnHeader><Label>Score</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Grade</Label></TableColumnHeader>
          <TableColumnHeader><Label>Pass</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Fixed</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Fail</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Error</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>N/A</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>SessionId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Score</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Grade</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Summary.Pass</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Summary.Fixed</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Summary.Fail</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Summary.Error</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Summary.NotApplicable</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>SessionId</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WindowsServerHardening.Result</Name>
      <ViewSelectedBy>
        <TypeName>WindowsServerHardening.Result</TypeName>
        <TypeName>Deserialized.WindowsServerHardening.Result</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Severity</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Actual</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Actual</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WindowsServerHardening.Control</Name>
      <ViewSelectedBy>
        <TypeName>WindowsServerHardening.Control</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Category</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Severity</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Expected</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Category</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExpectedDisplay</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WindowsServerHardening.SessionInfo</Name>
      <ViewSelectedBy>
        <TypeName>WindowsServerHardening.SessionInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>Mode</Label></TableColumnHeader>
          <TableColumnHeader><Label>Profile</Label></TableColumnHeader>
          <TableColumnHeader><Label>StartTime</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Changes</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>RolledBack</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StartTime</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ChangeCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RolledBack</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WindowsServerHardening.RollbackResult</Name>
      <ViewSelectedBy>
        <TypeName>WindowsServerHardening.RollbackResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ControlId</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ControlId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
